/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Environment variables ----------
.env
.env.*
!.env.example
*.pem

# ---------- Next.js ----------
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ---------- Production ----------
/build

# ---------- Tests ----------
/coverage

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Caches ----------
.cache/
.eslintcache
.turbo/

# ---------- Vercel ----------
.vercel

# ---------- OS ----------
.DS_Store
._*
Thumbs.db
Desktop.ini

# ---------- Editors / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
